# =====================================================================
# Variables de entorno de ejemplo - APF2 ASPEFO
#
# Copie este archivo como .env y complete los valores:
#   cp config/ejemplos.env .env
#
# NO versione el archivo .env. Solo este archivo de ejemplo se incluye
# en el repositorio, y no contiene credenciales reales.
# =====================================================================

# --- Puerto publicado en el host por el frontend (proxy inverso) ---
FRONTEND_PORT=8080

# --- Credenciales de la base de datos MySQL ---
# Genere una cadena aleatoria de al menos 16 caracteres.
MYSQL_PASSWORD=cambie_esta_contrasena_mysql
MYSQL_ROOT_PASSWORD=cambie_esta_contrasena_root

# --- Secreto de firma JWT (HS256) ---
# Genere una cadena aleatoria de al menos 32 bytes.
# NUNCA reutilice el valor de ejemplo 'dev-secret-key-...' en un entorno real.
JWT_SECRET=cambie_este_secreto_por_uno_aleatorio_de_32_bytes

# --- Origenes permitidos por CORS (origen del navegador) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# =====================================================================
# Mesa de ayuda (RF-09) - instancia autoalojada de FreeScout
#
# Son variables del docker/compose-helpdesk.yaml. Las credenciales NUNCA
# se versionan: este archivo solo documenta los marcadores de posicion.
# =====================================================================

# --- Credenciales de la base de datos propia de la mesa de ayuda ---
FREESCOUT_DB_PASSWORD=cambie_esta_contrasena_freescout
FREESCOUT_DB_ROOT_PASSWORD=cambie_esta_contrasena_freescout_root

# --- Datos del administrador inicial de la mesa de ayuda ---
FREESCOUT_ADMIN_EMAIL=cambie_esta_cuenta@correo.ejemplo
FREESCOUT_ADMIN_NAME=Administrador ASPEFO
FREESCOUT_ADMIN_PASSWORD=cambie_esta_contrasena_administrador

# --- URL publica del portal de tickets ---
# Debe apuntar al mismo origen del portal (o al dominio correspondiente)
# para que la mesa de ayuda no abra un borde secundario de entrada.
FREESCOUT_APP_URL=http://localhost:8080/soporte

# --- Zona horaria e idioma de la mesa de ayuda ---
FREESCOUT_TIMEZONE=America/Lima
FREESCOUT_LOCALE=es

# --- Correo para enviar y recibir tickets (SMTP) ---
# Dejelo vacio para usar un correo de prueba; en un despliegue real
# configure una cuenta transaccional en el archivo .env del equipo.
FREESCOUT_MAIL_HOST=
FREESCOUT_MAIL_PORT=587
FREESCOUT_MAIL_USERNAME=
FREESCOUT_MAIL_PASSWORD=
FREESCOUT_MAIL_ENCRYPTION=tls
FREESCOUT_MAIL_FROM=

# --- Limite de adjuntos por ticket (MB) ---
FREESCOUT_MAX_UPLOAD_MB=10
