# =====================================================================
# aspefo-demo  -  Portal institucional ASPEFO + modulo ENAO
#
# Construccion multi-stage: build con Node y runtime con Nginx.
# El servidor final sirve el build estatico y redirige /api al backend,
# de modo que el navegador usa un unico origen y no hay CORS.
# =====================================================================

# ---------- Stage 1: build ----------
FROM node:22-alpine AS build
WORKDIR /build

# Dependencias primero para aprovechar cache.
COPY app/aspefo-demo/package.json app/aspefo-demo/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY app/aspefo-demo/ ./

# VITE_API_URL apunta al backend visto desde el navegador.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---------- Stage 2: runtime con Nginx ----------
FROM nginx:1.27-alpine AS runtime

# Configuracion del servidor: SPA + proxy inverso hacia el backend.
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

# Healthcheck con un recurso propio y 127.0.0.1: en Alpine 'localhost' puede
# resolver a ::1 (IPv6) y el chequeo fallaria aunque nginx este sirviendo.
# '-O /dev/null' evita depender de que BusyBox reconozca '--spider'.
RUN echo "ok" > /usr/share/nginx/html/health.txt

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/health.txt || exit 1

CMD ["nginx", "-g", "daemon off;"]
